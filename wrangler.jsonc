{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unlimit-insure",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unlimit-insure",
      "database_id": "10bc6601-2379-4a44-b8ee-8ff48d897fcb",
      "migrations_dir": "migrations"
    }
  ],
  // Online purchase is off until real products, broker licence and receiving account are confirmed.
  // To switch on: create the bucket (npx wrangler r2 bucket create unlimit-insure-docs), uncomment r2_buckets,
  // set PURCHASE_ENABLED to "true", redeploy. See docs/deploy.md.
  // "r2_buckets": [{ "binding": "DOCS", "bucket_name": "unlimit-insure-docs" }],
  "vars": { "PURCHASE_ENABLED": "false" }
}
