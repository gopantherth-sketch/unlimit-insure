{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unlimit-insure",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unlimit-insure",
      "database_id": "10bc6601-2379-4a44-b8ee-8ff48d897fcb",
      "migrations_dir": "migrations"
    }
  ],
  // Private bucket for application documents and policy PDFs. Create once: npx wrangler r2 bucket create unlimit-insure-docs
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "unlimit-insure-docs" }]
}
