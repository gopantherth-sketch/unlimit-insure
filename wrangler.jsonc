{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unlimit-insure",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // workers.dev address off (Cloudflare review U4): the site lives only on unlimitinsure.com.
  "workers_dev": false,
  // Custom domains (registered on this Cloudflare account). Deploys create the DNS records.
  "routes": [
    { "pattern": "unlimitinsure.com", "custom_domain": true },
    { "pattern": "www.unlimitinsure.com", "custom_domain": true }
  ],
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unlimit-insure",
      "database_id": "10bc6601-2379-4a44-b8ee-8ff48d897fcb",
      "migrations_dir": "migrations"
    }
  ],
  // Online purchase is off until real products, broker licence and receiving account are confirmed.
  // To switch on: create the bucket (npx wrangler r2 bucket create unlimit-insure-docs), uncomment r2_buckets,
  // set PURCHASE_ENABLED to "true", redeploy. See docs/deploy.md.
  // "r2_buckets": [{ "binding": "DOCS", "bucket_name": "unlimit-insure-docs" }],
  // JOURNEY_REDIRECTS "1": no insurance products are published, so worker.ts answers the old journey pages
  // (/quote, /quote/results, /compare, /plans/*) with the advisor redirect (CLEAR row 41). Set "0" or remove
  // it in the same change that publishes real products.
  "vars": { "PURCHASE_ENABLED": "false", "JOURNEY_REDIRECTS": "1" }
}
