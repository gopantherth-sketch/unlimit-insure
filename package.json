{
  "name": "unlimit-insure",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply unlimit-insure --local",
    "db:migrate:remote": "wrangler d1 migrations apply unlimit-insure --remote",
    "db:seed:build": "tsx scripts/build-seed.ts",
    "db:seed:local": "wrangler d1 execute unlimit-insure --local --file seed/mock-catalog.sql",
    "db:seed:remote": "wrangler d1 execute unlimit-insure --remote --file seed/mock-catalog.sql"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.140.0"
  }
}
